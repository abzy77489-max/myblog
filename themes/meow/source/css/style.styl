    @import 'common/comment/waline'

#sidebar-info-img a {
  pointer-events: none;
  cursor: default;
}

// 去除作者名称下方动态横线动画
#sidebar-info-name,
.author-name,
.info-card .author-name {
  position: relative;

  &::after,
  &::before {
    display: none !important;
    animation: none !important;
    width: 0 !important;
  }

  &:hover::after,
  &:hover::before {
    width: 0 !important;
    animation: none !important;
  }

  a,
  a:hover,
  a:focus {
    text-decoration: none !important;
    border-bottom: none !important;

    &::after,
    &::before {
      display: none !important;
    }
  }
}